result
result-*
dist-newstyle/
.ghc.environment.*

# agent-functor world-acting run worktrees (leftover if a run is killed):
# --sandbox run isolation, and one per racing worker (raceN/raceWorkers)
.agent-functor-worktree-*
.agent-functor-worker-*

# agent-functor run-record store (local run state, not source):
.agent-functor/

# Retrospectives the retro workflows write at the root: artifacts for a person,
# deliberately untracked — read them, act on them, delete them.
RETRO-*.md

# Upstream prompt briefs (ponytail, awesome-prompts). NOT source: a symlink into
# /nix/store, dropped here by the devShell shellHook so a plain `cabal build`
# passes promptFile's compile-time check. `nix build` grafts the same store path
# into its own src and never looks at this.
/prompts/upstream
