cabal-version:      2.4
name:               incite-workflows
version:            0.1.0.0
synopsis:           Isaac's local agent-functor workflows (consumes the agent-functor library)

-- Rooted at the REPO root, not ./workflows, even though the only source file is
-- ./workflows/Main.hs. `Agent.Prompt.promptFile` checks its path at compile time
-- against the package root and resolves it at run time against the working
-- directory — so rooting the package where you stand when you run the binary is
-- what makes `prompts/plan.md` mean the same thing in both phases.
extra-source-files:
    prompts/*.md
    prompts/explore/*.md
    prompts/review/*.md
    prompts/retro/*.md
    -- Grafted in from the `flake = false` inputs; never in git (flake.nix).
    -- Every directory `Incite.Prompts` splices a `promptFile` from must be
    -- here: `extra-source-files` is what an sdist carries, and a `promptFile`
    -- path is checked when the module COMPILES, so a missing glob is a package
    -- that does not build outside a git checkout. `test/Spec.hs` asserts the
    -- cover, because nothing else in this repo can see the gap.
    prompts/upstream/ponytail/*.md
    prompts/upstream/awesome-prompts/*.md
    prompts/upstream/promptdeploy/*.md
    prompts/upstream/simple-english/*.md
    agents/*.md
    skills/*.md
    -- Slash commands read back as workflow briefs (fess-audit, implement).
    commands/fess.md
    commands/post-commit-audit.md
    commands/wiggum.md
    -- The recorded prompt bytes `test/Spec.hs` fences with `TIO.readFile`. Same
    -- rule as the prompt globs above and a worse failure without it: a golden
    -- read at run time is not checked when anything compiles, so an sdist that
    -- drops one builds clean and then fails the test suite with
    -- `openFile: does not exist`. `test/Spec.hs` asserts this cover too.
    test/golden/*.txt
    -- Read at run time by `test/Spec.hs`'s docs-inventory fence, same reason
    -- as the goldens above: an sdist that drops it builds clean and then fails
    -- the suite with `openFile: does not exist`.
    docs/workflows.md

-- The runner binary is named `agent-functor` so `nix run .#agent-functor -- run <name>` works.
library
    hs-source-dirs:     workflows
    exposed-modules:    Incite.Prompts
                        Incite.Backend
                        Incite.Feature
                        Incite.Review
    default-language:   GHC2021
    default-extensions: OverloadedStrings
                        QuasiQuotes
    ghc-options:        -Wall
    build-depends:
        base
      , text
      , agent-functor

executable agent-functor
    hs-source-dirs:     workflows
    main-is:            Main.hs
    default-language:   GHC2021
    default-extensions: OverloadedStrings
                        QuasiQuotes
    ghc-options:        -Wall -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base
      , text
      , agent-functor
      , incite-workflows

test-suite incite-test
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test
    main-is:            Spec.hs
    default-language:   GHC2021
    default-extensions: OverloadedStrings
    ghc-options:        -Wall -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base
      , text
      -- For the packaging cover: it quantifies over what is ON DISK under
      -- test/golden, not over a list in the test file, so the golden that goes
      -- missing from an sdist cannot be the one nobody wrote down twice.
      , directory
      , agent-functor
      , incite-workflows
      , tasty
      , tasty-hunit
